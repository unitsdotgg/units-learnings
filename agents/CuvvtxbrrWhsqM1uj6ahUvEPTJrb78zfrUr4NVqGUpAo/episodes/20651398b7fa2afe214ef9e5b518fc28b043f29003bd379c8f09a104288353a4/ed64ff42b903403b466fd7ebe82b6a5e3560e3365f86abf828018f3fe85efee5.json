    "patch": "diff --git a/minbpe/basic.py b/minbpe/basic.py\n--- a/minbpe/basic.py\n+++ b/minbpe/basic.py\n@@ -38,7 +38,8 @@ class BasicTokenizer(Tokenizer):\n             # (in first-occurrence order, as get_stats does)\n             stats = Counter(zip(ids, ids[1:]))\n             # find the pair with the highest count\n-            cpair = max(stats, key=stats.get)\n+            counts = list(stats.values())\n+            cpair = list(stats)[counts.index(max(counts))]\n             pair = (ord(cpair[0]), ord(cpair[1]))\n             # mint a new token: assign it the next available id\n             idx = 256 + i\ndiff --git a/minbpe/regex.py b/minbpe/regex.py\n--- a/minbpe/regex.py\n+++ b/minbpe/regex.py\n@@ -91,14 +91,16 @@ class RegexTokenizer(Tokenizer):\n         for i in range(num_merges):\n             # find the pair with the highest count; ties go to the pair that\n             # occurs first in the chunks, as with a freshly built stats dict\n-            best = max(stats.values())\n-            tied = [p for p, c in stats.items() if c == best]\n-            if len(tied) == 1:\n-                pair = tied[0]\n+            values = list(stats.values())\n+            best = max(values)\n+            if values.count(best) == 1:\n+                pair = list(stats)[values.index(best)]\n             else:\n-                tied = set(tied)\n-                pair = next(p for chunk_ids in ids\n-                            for p in zip(chunk_ids, chunk_ids[1:]) if p in tied)\n+                tied = {p for p, c in stats.items() if c == best}\n+                # where is exact, so only the earliest chunk holding a tied\n+                # pair needs to be scanned\n+                chunk_ids = ids[min(min(where[p]) for p in tied)]\n+                pair = next(p for p in zip(chunk_ids, chunk_ids[1:]) if p in tied)\n             # mint a new token: assign it the next available id\n             idx = 256 + i\n             # replace all occurrences of pair in ids with idx\n",
